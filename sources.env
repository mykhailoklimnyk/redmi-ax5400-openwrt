# Pinned sources. Change a pin only together with a review of what changed upstream.

# "nss" variant: OpenWrt with Qualcomm NSS for the RA74. Pinned to a reviewed commit.
NSS_REPO=https://github.com/Yongzhaooo/redmi-ax5400-nss.git
NSS_TAG=v2026.10.23-ath11k
NSS_COMMIT=5cda3d1036c80afca6673c5f4c96d772edf9c423

# "next" variant: the current NSS base for IPQ5018 (the project the "nss" source was forked
# from), at one of its release tags. Package feeds are pinned in config/feeds-next.conf, copied
# from that release's feeds-std.buildinfo. Not yet run on hardware by this project.
NEXT_REPO=https://github.com/kuncy7/openwrt-nss-edma.git
NEXT_TAG=ipq50xx-2026.11.20
NEXT_COMMIT=facdbc303784c50ac89c3027db0ab13ae33b5b35

# "official" variant: plain OpenWrt plus two pending upstream fixes.
# A branch name tracks that branch (the commit is recorded in the release notes); a full SHA pins it.
OFFICIAL_REPO=https://github.com/openwrt/openwrt.git
OFFICIAL_REF=main

# LuCI Argon theme (Apache-2.0), built from source at fixed commits.
ARGON_THEME_REPO=https://github.com/jerrykuku/luci-theme-argon.git
ARGON_THEME_COMMIT=c5c0873e122dc767c7ab0198c8bffc6e952b5cfb
ARGON_CONFIG_REPO=https://github.com/jerrykuku/luci-app-argon-config.git
ARGON_CONFIG_COMMIT=9f096c916c16be8075610dd137d3b18982f81f1e

# Upstream pull requests whose patches are carried in patches/ (watched by the weekly check).
WATCH_PRS="24763 26511"
